      "source": [
        "def miss_tests(target, others):\n",
        "    out = {}\n",
        "    for c in others:\n",
        "        x = pd.DataFrame({\"miss\": m[target].isna(), \"v\": m[c]}).dropna()\n",
        "        t = pd.crosstab(x[\"v\"], x[\"miss\"])\n",
        "        if t.shape[0] > 1 and t.shape[1] > 1:\n",
        "            p = stats.chi2_contingency(t)[1]\n",
        "            if p < 0.05:\n",
        "                out[c] = float(round(p, 3))\n",
        "    return out\n",
        "for tgt in [\"income\", \"parent_edu\", \"anaemia\", \"food_security\", \"wic_child\"]:\n",
        "    print(tgt, miss_tests(tgt, [\"age_years\", \"sex\"] + [c for c in NODES if c != tgt]))"
      ],
      "id": "yxKmJuY9lytJ"
