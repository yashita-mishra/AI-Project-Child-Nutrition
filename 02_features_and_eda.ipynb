        "d = m[m.anaemia.notna()]\n",
        "rows = []\n",
        "for c in NODES[:-1]:\n",
        "    x = d[[c, \"anaemia\"]].dropna()\n",
        "    ct = pd.crosstab(x[c], x[\"anaemia\"])\n",
        "    rows.append({\"node\": c, \"n\": len(x), \"p_chi2_anaemia\": round(stats.chi2_contingency(ct)[1], 3),\n",
        "                 \"anaemia_rate_by_level\": (ct[\"yes\"] / ct.sum(axis=1)).round(3).to_dict()})\n",
        "g = m[m.hb_margin.notna()]\n",
        "for r in rows:\n",
        "    x = g[[r[\"node\"], \"hb_margin\"]].dropna()\n",
        "    groups = [v.hb_margin.values for _, v in x.groupby(r[\"node\"], observed=True)]\n",
        "    r[\"p_kruskal_hb_margin\"] = round(stats.kruskal(*groups)[1], 4)\n",
        "pd.DataFrame(rows).set_index(\"node\")"
      ],
      "id": "XDaleIy5lytI"
