          "metadata": {},
          "execution_count": 5
        }
      ],
      "source": [
        "m = pd.DataFrame({\"id\": df[\"id\"], \"age_years\": df[\"age_years\"].astype(int), \"sex\": df[\"sex\"]})\n",
        "m[\"ethnicity\"] = df[\"ethnicity\"]\n",
        "m[\"parent_edu\"] = df[\"parent_edu\"].map({1: \"low\", 2: \"mid\", 3: \"high\"})\n",
        "m[\"income\"] = pd.cut(df[\"income_poverty_ratio\"], [-0.01, 1, 1.85, 5.01],\n",
        "                     labels=[\"below_poverty\", \"to_185pct\", \"above_185pct\"])\n",
        "m[\"wic_child\"] = df[\"child_ever_wic\"].map({1: \"yes\", 2: \"no\"})\n",
        "m[\"snap_past_year\"] = np.where(df[\"hh_snap_ever\"] == 2, \"no\",\n",
        "                      np.where(df[\"hh_snap_ever\"] == 1,\n",
        "                               np.where(df[\"hh_snap_past_year\"] == 1, \"yes\", \"no\"), None))\n",
        "m[\"food_security\"] = df[\"adult_food_security\"].map({1: \"secure\", 2: \"secure\", 3: \"insecure\", 4: \"insecure\"})\n",
        "m[\"ever_breastfed\"] = df[\"ever_breastfed\"].map({1: \"yes\", 2: \"no\"})\n",
        "m[\"milk_before_12m\"] = np.where(df[\"first_milk_days\"].notna(),\n",
        "                                np.where(df[\"first_milk_days\"] < 365, \"yes\", \"no\"),\n",
        "                                np.where(df[\"milk_never\"], \"no\", None))\n",
        "m[\"low_birth_weight\"] = df[\"low_birth_weight\"].map({0.0: \"no\", 1.0: \"yes\"})\n",
        "m[\"anaemia\"] = df[\"anaemia\"].map({0.0: \"no\", 1.0: \"yes\"})\n",
        "m[\"hb_level\"] = df[\"hb_level\"].astype(\"object\")\n",
        "m[\"hb_margin\"] = df[\"hb_margin\"]\n",
        "m[\"mchc\"] = df[\"mchc\"]\n",
        "m[\"anaemia_severity\"] = df[\"anaemia_severity\"]\n",
        "m[\"weight_exam\"] = df[\"weight_exam\"]            # survey weight, for population estimates\n",
        "\n",
        "NODES = [\"ethnicity\", \"parent_edu\", \"income\", \"wic_child\", \"snap_past_year\", \"food_security\",\n",
        "         \"ever_breastfed\", \"milk_before_12m\", \"low_birth_weight\", \"anaemia\"]\n",
        "m.to_csv(\"data/children_model.csv\", index=False)\n",
        "complete = m.dropna(subset=NODES)\n",
        "complete.to_csv(\"data/children_complete.csv\", index=False)\n",
        "print(\"model table:\", m.shape, \" complete cases on nodes:\", len(complete))\n",
        "m[NODES].apply(lambda s: s.value_counts(dropna=False).to_dict())"
      ],
      "id": "wfXIe5kxlytH"
